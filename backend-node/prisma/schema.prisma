generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users         User[]
  projects      Project[]
  work_items    WorkItem[]
  sprints       Sprint[]
  forms         Form[]
  notifications Notification[]
  cohorts       Cohort[]
  action_items  ActionItem[]
  roles         Role[]
  work_policy   OrganizationWorkPolicy?
  audit_logs    AuditLog[]
  extension_requests WorkItemExtensionRequest[]

  @@map("organizations")
}

model OrganizationWorkPolicy {
  id                  String   @id @default(uuid())
  organization_id     String   @unique
  office_start_time   String   @default("09:00")
  office_end_time     String   @default("17:30")
  break_start_time    String?
  break_end_time      String?
  lunch_break_minutes Int      @default(60)
  timezone            String   @default("Asia/Kolkata")
  overtime_enabled    Boolean  @default(false)
  overtime_start_time String?  @default("17:30")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("organization_work_policies")
}

model User {
  id                   String   @id @default(uuid())
  organization_id      String?
  name                 String
  email                String   @unique
  user_code            String?
  cohort_id            String?
  batch                String?
  subbatch             String?
  must_change_password Boolean  @default(true)
  password_hash        String
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  organization           Organization?           @relation(fields: [organization_id], references: [id])
  cohort                 Cohort?                 @relation(fields: [cohort_id], references: [id], onDelete: SetNull)
  roles                  UserRole[]
  sessions               UserSession[]
  work_sessions          WorkSession[]
  time_entries           TimeEntry[]
  owned_projects         Project[]               @relation("ProjectOwner")
  project_memberships    ProjectMember[]
  created_work_items     WorkItem[]              @relation("WorkItemCreator")
  work_item_assignments  WorkItemAssignee[]
  created_forms          Form[]                  @relation("FormCreator")
  form_submissions       FormSubmission[]        @relation("FormSubmitter")
  sent_notifications     Notification[]          @relation("SentNotifications")
  received_notifications NotificationRecipient[] @relation("ReceivedNotifications")
  assigned_action_items  ActionItem[]            @relation("ActionItemAssignee")
  created_action_items   ActionItem[]            @relation("ActionItemCreator")
  work_item_comments     WorkItemComment[]       @relation("WorkItemCommentAuthor")
  audit_logs             AuditLog[]
  requested_extensions   WorkItemExtensionRequest[] @relation("ExtensionRequester")
  reviewed_extensions    WorkItemExtensionRequest[] @relation("ExtensionReviewer")
  user_permissions       UserPermission[]
  project_ownerships     ProjectOwner[]          @relation("ProjectOwners")
  reported_bugs          BugReport[]             @relation("BugReporter")
  assigned_qa_complaints BugReport[]             @relation("BugReportQaAssignee")
  reviewed_bugs          BugReview[]             @relation("BugReviewer")
  assigned_bugs          Bug[]                   @relation("BugAssignee")
  assigned_bug_history   BugAssignment[]         @relation("BugAssignmentRecipient")
  made_bug_assignments   BugAssignment[]         @relation("BugAssignmentAuthor")
  conducted_retests      BugRetest[]             @relation("BugRetester")
  bug_comments           BugComment[]            @relation("BugCommentAuthor")
  bug_attachments        BugAttachment[]         @relation("BugAttachmentUploader")
  bug_events             BugEvent[]              @relation("BugEventActor")
  updated_requirements   DocumentRequirement[]   @relation("RequirementUpdatedBy")

  @@unique([organization_id, user_code])
  @@index([cohort_id])
  @@map("users")
}

model Cohort {
  id              String    @id @default(uuid())
  organization_id String
  name            String
  code            String
  description     String?
  start_date      DateTime?
  end_date        DateTime?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organization_id, code])
  @@index([organization_id])
  @@map("cohorts")
}

model WorkSession {
  id              String    @id @default(uuid())
  organization_id String
  user_id         String
  task_id         String?
  started_at      DateTime
  ended_at        DateTime?
  break_minutes   Int       @default(0)
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task         WorkItem?   @relation(fields: [task_id], references: [id], onDelete: SetNull)
  time_entries TimeEntry[]

  @@index([organization_id, user_id])
  @@index([user_id, started_at])
  @@index([user_id, task_id, ended_at])
  @@map("work_sessions")
}

model TimeEntry {
  id               String   @id @default(uuid())
  organization_id  String
  user_id          String
  task_id          String
  project_id       String?
  work_session_id  String?
  date             DateTime
  start_time       DateTime
  end_time         DateTime
  duration_minutes Int      @default(0)
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task         WorkItem     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  work_session WorkSession? @relation(fields: [work_session_id], references: [id], onDelete: SetNull)

  @@index([organization_id, user_id, date])
  @@index([task_id])
  @@index([user_id, start_time])
  @@index([project_id])
  @@map("time_entries")
}

model Role {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  organization_id String?
  project_id      String?
  is_custom       Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users           UserRole[]
  permissions     RolePermission[]
  project_members ProjectMember[]
  member_roles    ProjectMemberRole[]

  @@index([organization_id])
  @@index([project_id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  roles            RolePermission[]
  user_permissions UserPermission[]

  @@map("permissions")
}

model UserPermission {
  id            String   @id @default(uuid())
  user_id       String
  permission_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_id])
  @@index([user_id])
  @@index([permission_id])
  @@map("user_permissions")
}

model UserRole {
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserSession {
  id                 String    @id @default(uuid())
  user_id            String
  refresh_token_hash String
  expires_at         DateTime
  created_at         DateTime  @default(now())
  revoked_at         DateTime?
  last_used_at       DateTime?
  user_agent         String?
  ip_address         String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_sessions")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectMethodology {
  SCRUM
  KANBAN
}

model Project {
  id              String             @id @default(uuid())
  organization_id String
  owner_id        String
  name            String
  description     String?
  methodology     ProjectMethodology @default(SCRUM)
  start_date      DateTime?
  end_date        DateTime?
  status          ProjectStatus      @default(PLANNED)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id])
  owner        User              @relation("ProjectOwner", fields: [owner_id], references: [id])
  owners       ProjectOwner[]
  members      ProjectMember[]
  documents    ProjectDocument[]
  work_items   WorkItem[]
  sprints      Sprint[]
  forms        Form[]
  time_entries TimeEntry[]
  action_items ActionItem[]
  roles        Role[]
  extension_requests WorkItemExtensionRequest[]
  bug_reports        BugReport[]
  bugs               Bug[]
  bug_attachments    BugAttachment[]

  @@map("projects")
}

model ProjectOwner {
  project_id String
  user_id    String
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectOwners", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@map("project_owners")
}

model ProjectMember {
  project_id   String
  user_id      String
  project_role String?
  role_id      String?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [role_id], references: [id], onDelete: SetNull)
  member_roles ProjectMemberRole[]

  @@id([project_id, user_id])
  @@map("project_members")
}

model ProjectMemberRole {
  id           String   @id @default(uuid())
  project_id   String
  user_id      String
  role_name    String
  role_id      String?
  created_at   DateTime @default(now())

  project_member ProjectMember @relation(fields: [project_id, user_id], references: [project_id, user_id], onDelete: Cascade)
  role           Role?          @relation(fields: [role_id], references: [id], onDelete: SetNull)

  @@unique([project_id, user_id, role_name])
  @@index([project_id, user_id])
  @@map("project_member_roles")
}

model ProjectDocument {
  id            String   @id @default(uuid())
  project_id    String
  name          String
  document_type String
  storage_key   String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project      Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requirements DocumentRequirement[]

  @@map("project_documents")
}

enum WorkItemType {
  EPIC
  STORY
  TASK
  SUBTASK
  BUG
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Sprint {
  id              String       @id @default(uuid())
  organization_id String
  project_id      String
  name            String
  goal            String?
  start_date      DateTime?
  end_date        DateTime?
  status          SprintStatus @default(PLANNED)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_items   WorkItem[]

  @@index([organization_id, project_id])
  @@map("sprints")
}

model WorkItem {
  id              String           @id @default(uuid())
  organization_id String
  project_id      String?
  sprint_id       String?
  parent_id       String?
  created_by      String
  type            WorkItemType
  title           String
  description     String?
  status          WorkItemStatus   @default(TODO)
  priority        WorkItemPriority @default(MEDIUM)
  start_date      DateTime?
  due_date        DateTime?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  completed_at    DateTime?
  story_points    Int?             @default(0)

  organization  Organization         @relation(fields: [organization_id], references: [id])
  project       Project?             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sprint        Sprint?              @relation(fields: [sprint_id], references: [id], onDelete: SetNull)
  parent        WorkItem?            @relation("WorkItemHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children      WorkItem[]           @relation("WorkItemHierarchy")
  creator       User                 @relation("WorkItemCreator", fields: [created_by], references: [id])
  assignees     WorkItemAssignee[]
  attachments   WorkItemAttachment[]
  comments      WorkItemComment[]
  time_entries  TimeEntry[]
  work_sessions WorkSession[]
  extension_requests WorkItemExtensionRequest[]

  @@index([organization_id])
  @@index([project_id])
  @@index([sprint_id])
  @@index([created_by])
  @@index([parent_id])
  @@map("work_items")
}

model WorkItemComment {
  id           String   @id @default(uuid())
  work_item_id String
  author_id    String
  content      String   @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)
  author    User     @relation("WorkItemCommentAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  @@index([work_item_id])
  @@index([author_id])
  @@index([work_item_id, created_at])
  @@map("work_item_comments")
}

model WorkItemAssignee {
  work_item_id String
  user_id      String
  created_at   DateTime @default(now())

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([work_item_id, user_id])
  @@map("work_item_assignees")
}

model WorkItemAttachment {
  id           String   @id @default(uuid())
  work_item_id String
  name         String
  storage_key  String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)

  @@index([work_item_id])
  @@map("work_item_attachments")
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  DATE
}

model Form {
  id              String     @id @default(uuid())
  organization_id String
  project_id      String?
  creator_id      String
  title           String
  description     String?
  status          FormStatus @default(DRAFT)
  target_roles    String[] // e.g. ["INTERN"]
  deadline        DateTime?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id])
  project      Project?         @relation(fields: [project_id], references: [id], onDelete: SetNull)
  creator      User             @relation("FormCreator", fields: [creator_id], references: [id])
  questions    FormQuestion[]
  submissions  FormSubmission[]

  @@index([organization_id])
  @@index([project_id])
  @@map("forms")
}

model FormQuestion {
  id          String       @id @default(uuid())
  form_id     String
  type        QuestionType
  text        String
  description String?
  is_required Boolean      @default(true)
  order_index Int
  options     String[] // For select type questions

  form    Form               @relation(fields: [form_id], references: [id], onDelete: Cascade)
  answers SubmissionAnswer[]

  @@index([form_id])
  @@map("form_questions")
}

model FormSubmission {
  id           String   @id @default(uuid())
  form_id      String
  submitter_id String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  form      Form               @relation(fields: [form_id], references: [id], onDelete: Cascade)
  submitter User               @relation("FormSubmitter", fields: [submitter_id], references: [id])
  answers   SubmissionAnswer[]

  @@index([form_id])
  @@index([submitter_id])
  @@map("form_submissions")
}

model SubmissionAnswer {
  id            String   @id @default(uuid())
  submission_id String
  question_id   String
  value_string  String?
  value_number  Float?
  value_boolean Boolean?
  value_array   String[]

  submission FormSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question   FormQuestion   @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([submission_id])
  @@index([question_id])
  @@map("submission_answers")
}

enum NotificationType {
  BROADCAST
  DIRECT
  SYSTEM
  TASK_ASSIGNED
  FORM_ASSIGNED
}

model Notification {
  id              String           @id @default(uuid())
  organization_id String
  sender_id       String
  title           String
  message         String
  type            NotificationType @default(BROADCAST)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  sender       User                    @relation("SentNotifications", fields: [sender_id], references: [id], onDelete: Cascade)
  recipients   NotificationRecipient[]

  @@index([organization_id])
  @@index([sender_id])
  @@map("notifications")
}

model NotificationRecipient {
  id              String    @id @default(uuid())
  notification_id String
  user_id         String
  read_at         DateTime?
  delivered       Boolean   @default(false)
  created_at      DateTime  @default(now())
  archived_at     DateTime?

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation("ReceivedNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, user_id])
  @@index([notification_id])
  @@index([user_id])
  @@index([user_id, read_at])
  @@map("notification_recipients")
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ActionItem {
  id              String             @id @default(uuid())
  organization_id String
  project_id      String
  title           String
  description     String?
  status          ActionItemStatus   @default(OPEN)
  priority        ActionItemPriority @default(MEDIUM)
  assignee_id     String?
  creator_id      String             @map("creator_id")
  due_date        DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ActionItemAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  creator      User         @relation("ActionItemCreator", fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([project_id])
  @@index([assignee_id])
  @@index([creator_id])
  @@map("action_items")
}

model AuditLog {
  id              String   @id @default(uuid())
  actor_id        String?
  organization_id String?
  action          String
  target_type     String
  target_id       String
  metadata        Json?
  ip_address      String?
  user_agent      String?
  created_at      DateTime @default(now())

  actor        User?         @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)

  @@index([actor_id])
  @@index([organization_id])
  @@index([target_type, target_id])
  @@index([action, created_at])
  @@map("audit_logs")
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WorkItemExtensionRequest {
  id                 String                 @id @default(uuid())
  organization_id    String
  project_id         String
  task_id            String                 @map("task_id")
  requester_id       String
  original_due_date  DateTime?
  requested_due_date DateTime
  reason             String                 @db.Text
  status             ExtensionRequestStatus @default(PENDING)
  reviewer_id        String?
  decision_note      String?                @db.Text
  created_at         DateTime               @default(now())
  reviewed_at        DateTime?
  updated_at         DateTime               @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task         WorkItem     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  requester    User         @relation("ExtensionRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("ExtensionReviewer", fields: [reviewer_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([project_id])
  @@index([task_id])
  @@index([requester_id])
  @@index([status])
  @@index([task_id, status])
  @@map("work_item_extension_requests")
}

// ── Parent Document Requirements ─────────────────────────────────────────────
enum RequirementStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model DocumentRequirement {
  id                 String            @id @default(uuid())
  document_id        String
  code               String?
  title              String
  description        String?           @db.Text
  section            String?
  status             RequirementStatus @default(PENDING)
  progress_note      String?           @db.Text
  current_activity   String?           @db.Text
  updated_by_user_id String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  document   ProjectDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  updated_by User?           @relation("RequirementUpdatedBy", fields: [updated_by_user_id], references: [id], onDelete: SetNull)

  @@index([document_id])
  @@index([updated_by_user_id])
  @@map("document_requirements")
}

// ── DAILOQA Bug Management & QA Retest Portal Enums ──────────────────────────
enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BugReportStatus {
  PENDING_REVIEW
  NEED_INFO
  VERIFIED
  REJECTED
  DUPLICATE
}

enum BugReviewOutcome {
  VERIFIED
  INFO_REQUESTED
  REJECTED
  DUPLICATE
}

enum BugStatus {
  OPEN
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  FIXED
  READY_FOR_RETEST
  CLOSED
  REOPENED
}

enum BugRetestResult {
  PASS
  FAIL
}

// ── DAILOQA Bug Management & QA Retest Portal Models ─────────────────────────
model BugReport {
  id                 String          @id @default(uuid())
  project_id         String
  reporter_id        String
  title              String
  description        String          @db.Text
  steps_to_reproduce String          @db.Text
  expected_result    String          @db.Text
  actual_result      String          @db.Text
  environment        String?
  severity           BugSeverity     @default(MEDIUM)
  assigned_qa_id     String?
  status             BugReportStatus @default(PENDING_REVIEW)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  project      Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  reporter     User            @relation("BugReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  assigned_qa  User?           @relation("BugReportQaAssignee", fields: [assigned_qa_id], references: [id], onDelete: SetNull)
  reviews      BugReview[]
  official_bug Bug?            @relation("ReportToBug")
  comments     BugComment[]
  attachments  BugAttachment[]
  events       BugEvent[]

  @@index([project_id])
  @@index([reporter_id])
  @@index([assigned_qa_id])
  @@index([status])
  @@map("bug_reports")
}

model BugReview {
  id              String           @id @default(uuid())
  bug_report_id   String
  reviewer_id     String
  outcome         BugReviewOutcome
  notes           String           @db.Text
  duplicate_of_id String?
  created_at      DateTime         @default(now())

  bug_report   BugReport @relation(fields: [bug_report_id], references: [id], onDelete: Cascade)
  reviewer     User      @relation("BugReviewer", fields: [reviewer_id], references: [id], onDelete: Cascade)
  duplicate_of Bug?      @relation("DuplicateReviews", fields: [duplicate_of_id], references: [id], onDelete: SetNull)

  @@index([bug_report_id])
  @@index([reviewer_id])
  @@map("bug_reviews")
}

model Bug {
  id                  String      @id @default(uuid())
  project_id          String
  origin_report_id    String?     @unique
  bug_code            String
  title               String
  description         String      @db.Text
  status              BugStatus   @default(OPEN)
  severity            BugSeverity @default(MEDIUM)
  priority            BugPriority @default(MEDIUM)
  current_assignee_id String?
  triage_notes        String?     @db.Text
  resolution_summary  String?     @db.Text
  fixed_in_build      String?
  closed_at           DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  project           Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  origin_report     BugReport?      @relation("ReportToBug", fields: [origin_report_id], references: [id], onDelete: SetNull)
  current_assignee  User?           @relation("BugAssignee", fields: [current_assignee_id], references: [id], onDelete: SetNull)
  assignments       BugAssignment[]
  retests           BugRetest[]
  comments          BugComment[]
  attachments       BugAttachment[]
  events            BugEvent[]
  duplicate_reviews BugReview[]     @relation("DuplicateReviews")

  @@unique([project_id, bug_code])
  @@index([project_id])
  @@index([status])
  @@index([current_assignee_id])
  @@map("bugs")
}

model BugAssignment {
  id             String   @id @default(uuid())
  bug_id         String
  assignee_id    String
  assigned_by_id String
  notes          String?  @db.Text
  assigned_at    DateTime @default(now())

  bug         Bug  @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  assignee    User @relation("BugAssignmentRecipient", fields: [assignee_id], references: [id], onDelete: Cascade)
  assigned_by User @relation("BugAssignmentAuthor", fields: [assigned_by_id], references: [id], onDelete: Cascade)

  @@index([bug_id])
  @@index([assignee_id])
  @@map("bug_assignments")
}

model BugRetest {
  id             String          @id @default(uuid())
  bug_id         String
  retester_id    String
  attempt_number Int
  tested_build   String
  result         BugRetestResult
  notes          String          @db.Text
  status_before  BugStatus
  status_after   BugStatus
  created_at     DateTime        @default(now())

  bug         Bug             @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  retester    User            @relation("BugRetester", fields: [retester_id], references: [id], onDelete: Cascade)
  attachments BugAttachment[]

  @@index([bug_id])
  @@index([retester_id])
  @@map("bug_retests")
}

model BugComment {
  id            String   @id @default(uuid())
  bug_id        String?
  bug_report_id String?
  author_id     String
  content       String   @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  bug        Bug?       @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  bug_report BugReport? @relation(fields: [bug_report_id], references: [id], onDelete: Cascade)
  author     User       @relation("BugCommentAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  @@index([bug_id])
  @@index([bug_report_id])
  @@index([author_id])
  @@map("bug_comments")
}

model BugAttachment {
  id              String   @id @default(uuid())
  project_id      String
  bug_report_id   String?
  bug_id          String?
  retest_id       String?
  uploaded_by     String
  storage_key     String
  original_name   String
  sanitized_name  String
  mime_type       String
  file_size_bytes Int
  checksum_sha256 String
  created_at      DateTime @default(now())

  project    Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  bug_report BugReport? @relation(fields: [bug_report_id], references: [id], onDelete: Cascade)
  bug        Bug?       @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  retest     BugRetest? @relation(fields: [retest_id], references: [id], onDelete: Cascade)
  uploader   User       @relation("BugAttachmentUploader", fields: [uploaded_by], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([bug_report_id])
  @@index([bug_id])
  @@index([retest_id])
  @@map("bug_attachments")
}

model BugEvent {
  id            String   @id @default(uuid())
  bug_id        String?
  bug_report_id String?
  actor_id      String
  action        String
  from_status   String?
  to_status     String?
  metadata      Json?
  created_at    DateTime @default(now())

  bug        Bug?       @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  bug_report BugReport? @relation(fields: [bug_report_id], references: [id], onDelete: Cascade)
  actor      User       @relation("BugEventActor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([bug_id])
  @@index([bug_report_id])
  @@index([actor_id])
  @@map("bug_events")
}
